# Copy the complete Authorization value from an ECNPlus request.
# This file is an example. Store the real credential in .env (never commit it).
ECNPLUS_AUTHORIZATION=Bearer PASTE_TOKEN_HERE

# Hosted mode only. Copy the two Neon connection strings; keep TLS enabled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
# Run python -m ecnplus.cloud_admin prepare to generate the next values locally.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ACCESS_CODE_YASMINE=
ACCESS_CODE_HOUSSEIN=
ACCESS_CODE_AUTRE=
# Render supplies RENDER_EXTERNAL_URL automatically. Set this for a custom domain
# or when running hosted mode locally behind HTTPS.
# PUBLIC_BASE_URL=https://your-app.onrender.com
